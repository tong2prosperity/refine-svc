<Window x:Class="SvcClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SVC Client - 语音转换服务客户端" 
        Height="600" 
        Width="900"
        MinHeight="400"
        MinWidth="600"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="SVC 语音转换服务" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Python后台服务管理客户端" 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8" 
                Padding="20"
                Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                  Opacity="0.1" 
                                  BlurRadius="10" 
                                  ShadowDepth="2"/>
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" 
                             Width="16" 
                             Height="16" 
                             Fill="{StaticResource TextSecondaryBrush}"
                             Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" 
                               Text="正在初始化..." 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Service Info -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10,0">
                    <TextBlock Text="端口: " 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"/>
                    <TextBlock x:Name="PortText" 
                               Text="8105" 
                               FontSize="14" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text=" | " 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="10,0"
                               FontSize="14"/>
                    <TextBlock Text="工作目录: " 
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="14"/>
                    <TextBlock x:Name="WorkDirText" 
                               Text=".." 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               MaxWidth="200"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Manual Control (Optional) -->
                <Button x:Name="RestartButton"
                        Grid.Column="2"
                        Content="重启服务"
                        Style="{StaticResource ModernButton}"
                        Click="RestartButton_Click"
                        IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- Log Viewer -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBrush}" 
                CornerRadius="8"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                  Opacity="0.1" 
                                  BlurRadius="10" 
                                  ShadowDepth="2"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log Header -->
                <Border Grid.Row="0" 
                        Background="{StaticResource PrimaryBrush}" 
                        CornerRadius="8,8,0,0"
                        Padding="15,10">
                    <TextBlock Text="服务日志" 
                               Foreground="White" 
                               FontSize="14" 
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Log Content -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              Padding="15">
                    <TextBlock x:Name="LogTextBlock" 
                               TextWrapping="Wrap" 
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <TextBlock Text="提示: 关闭此窗口将自动停止Python服务" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       FontStyle="Italic"/>
        </StackPanel>
    </Grid>
</Window>
